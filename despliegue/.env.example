# Copiar como ".env" junto a docker-compose.yml y rellenar.
# Generar contraseñas con:  openssl rand -hex 24

PREFECT_VERSION=3.9.2

POSTGRES_USER=prefect
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_DB=prefect

# IP fija de la VM (la que se usa en el navegador: http://IP:4200)
SERVER_IP=192.168.0.17

# Usuario y contraseña del dashboard, con el formato usuario:contraseña
PREFECT_AUTH_STRING=admin:CAMBIAR

RETENCION_DIAS=90
TZ=Europe/Madrid
