# ==========================================================
# Plantilla de configuración. Copiar como ".env" en la raíz
# del proyecto (junto a los .bat) y rellenar los valores.
# El .env real NO se versiona (está en .gitignore).
#
# Lo usan todos los scripts a través de comun/db.py:
#   TablaActirep, TablaDocen, TablaEcri, TablaMvts,
#   TablasBalanBalme y Compras/*
# ==========================================================

# Servidor de Azure SQL, p. ej. miservidor.database.windows.net
Server = 'cadena de conexion del servidor'

# Nombre de la base de datos
Database = 'nombre de la base de datos'

# Usuario y contraseña de SQL Server.
# Usar comillas simples si la contraseña tiene $ u otros símbolos.
UsernameDB = 'usuario de la base de datos'
Password = 'contraseña del usuario'

# (Opcional) Driver ODBC. Por defecto: ODBC Driver 17 for SQL Server
# SqlDriver = 'ODBC Driver 17 for SQL Server'

# ----------------------------------------------------------
# Enlaces de descarga de las tablas Paradox: URL del blob de
# Azure con su token SAS de solo lectura (Azure Portal ->
# cuenta bodegaotazualmacen -> contenedor paradox -> archivo
# -> "Generar SAS"). Siempre entre comillas simples.
# El nombre es PARADOX_URL_ + nombre de la tabla en mayúsculas.
# ----------------------------------------------------------
# TablaActirep
PARADOX_URL_ACTIREP = 'https://bodegaotazualmacen.blob.core.windows.net/paradox/Actirep.DB?<token SAS>'
# TablaDocen
PARADOX_URL_DOCEN = 'https://bodegaotazualmacen.blob.core.windows.net/paradox/DOCEN.DB?<token SAS>'
PARADOX_URL_DELRG = 'https://bodegaotazualmacen.blob.core.windows.net/paradox/DELRG.DB?<token SAS>'
PARADOX_URL_DOCEC = 'https://bodegaotazualmacen.blob.core.windows.net/paradox/Docec.DB?<token SAS>'
PARADOX_URL_ADHES = 'https://bodegaotazualmacen.blob.core.windows.net/paradox/ADHES.DB?<token SAS>'
PARADOX_URL_CODIV = 'https://bodegaotazualmacen.blob.core.windows.net/paradox/codiv.DB?<token SAS>'
# TablaEcri
PARADOX_URL_ECRI = 'https://bodegaotazualmacen.blob.core.windows.net/paradox/Ecri.DB?<token SAS>'
# TablaMvts
PARADOX_URL_MVTS = 'https://bodegaotazualmacen.blob.core.windows.net/paradox/mvts.DB?<token SAS>'
# TablasBalanBalme
PARADOX_URL_BALAN = 'https://bodegaotazualmacen.blob.core.windows.net/paradox/BALAN.DB?<token SAS>'
PARADOX_URL_BALME = 'https://bodegaotazualmacen.blob.core.windows.net/paradox/BALME.DB?<token SAS>'
